---
import { experience, education } from "../data/site";
---

<ol>
  {
    experience.map((job, i) => (
      <li
        class="grid gap-4 border-t border-rule py-10 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-10"
        data-reveal
        style={`--reveal-delay:${i * 80}ms`}>
        <div>
          <p class="text-[0.8125rem] text-ink-3">{job.period}</p>
          {job.current && (
            <p class="label mt-2 !text-accent" aria-label="Current role">
              Now
            </p>
          )}
        </div>

        <div>
          <h3 class="display text-[1.5rem] text-ink">{job.title}</h3>
          <p class="mt-1.5 text-[0.9375rem] text-ink-2">
            {job.company}
            {job.team && <span class="text-ink-3"> · {job.team}</span>}
            <span class="text-ink-3"> · {job.location}</span>
          </p>

          <ul class="mt-5 space-y-2.5">
            {job.bullets.map((b) => (
              <li class="relative pl-4 text-[0.9375rem] leading-relaxed text-ink-2">
                <span
                  class="absolute left-0 top-[0.72em] h-px w-2 bg-rule-2"
                  aria-hidden="true"
                />
                {b}
              </li>
            ))}
          </ul>

          {/* No stack chips here — the Toolkit section and each case study
              already carry them, and a chip row per role made the timeline
              read like a résumé. */}
        </div>
      </li>
    ))
  }
</ol>

<div class="border-t border-rule pt-10" data-reveal>
  <p class="label">Education</p>
  {
    education.map((ed) => (
      <div class="mt-5 grid gap-4 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-10">
        <p class="text-[0.8125rem] text-ink-3">{ed.period}</p>
        <div>
          <h3 class="display text-[1.5rem] text-ink">{ed.school}</h3>
          <p class="mt-1.5 text-[0.9375rem] text-ink-2">{ed.degree}</p>
          {ed.detail && <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-3">{ed.detail}</p>}
        </div>
      </div>
    ))
  }
</div>
