---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

{/* Kept modest so the home page's sunset band doesn't end up orphaned above it,
    while the case-study and 404 pages — which have no closing image — still get
    clear air between their last block and this. */}
<footer class="mt-20">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-2 border-t border-rule px-6 py-9 text-[0.8125rem] text-ink-3 sm:flex-row sm:items-center sm:justify-between sm:px-10">
    <p>© {year} {site.name}</p>
    <p>Built with Astro · set in Newsreader &amp; DM Sans</p>
  </div>
</footer>
