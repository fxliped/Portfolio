---
/**
 * A real raster/vector image dropped into public/ — screenshots, photos, logos.
 *
 * width and height are required on purpose: without them the browser can't
 * reserve space and the page reflows as images arrive, which is the single most
 * common source of layout shift on an otherwise fast site.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  /** Figure number, continuing the sequence from any diagrams above. */
  fig?: number;
  /** Above-the-fold images should load eagerly; everything else lazy. */
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  caption,
  fig,
  eager = false,
  class: className = "",
} = Astro.props;
---

<figure class={className} data-reveal>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="h-auto w-full rounded-md border border-rule bg-paper-2"
    style={`aspect-ratio:${width} / ${height}`}
  />
  {
    caption && (
      <figcaption class="mt-3 text-[0.8125rem] leading-relaxed text-ink-3">
        {fig && <span class="fig-num">Fig. {fig}</span>}
        {caption}
      </figcaption>
    )
  }
</figure>
