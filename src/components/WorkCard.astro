---
import Icon from "./Icon.astro";
import Diagram from "./Diagram.astro";

interface Props {
  index: number;
  href: string;
  title: string;
  tagline: string;
  /** Where it was built. Reviewers read this before the title. */
  org: string;
  period: string;
  /** Diagram key from the case study's first figure — the panel's visual. */
  diagram?: string;
  stack: readonly string[];
  metrics: readonly { value: string; label: string }[];
  delay?: number;
}
const {
  index,
  href,
  title,
  tagline,
  org,
  period,
  diagram,
  stack,
  metrics,
  delay = 0,
} = Astro.props;

/* Two figures, not four. In a half-width panel four columns crush the labels,
   and the full set is on the case study anyway. */
const shown = metrics.slice(0, 2);
/* Four chips fit one line at the narrowest panel width; the rest become a count
   so the row never wraps into a ragged block. */
const chips = stack.slice(0, 4);
const extra = stack.length - chips.length;

/* One accent per panel, cycling. The class re-points --color-accent for this
   subtree, so the rule, tagline, arrow-hover and the diagram's own accent
   strokes all shift to the same colour without a second prop. */
const ACCENTS = ["accent-blue", "accent-orange", "accent-purple"] as const;
const accent = ACCENTS[(index - 1) % ACCENTS.length];
---

{/* A panel, not the old index row: the diagram carries the visual and the grid
    lets two studies sit side by side. Hover tints and moves the arrow — it
    still never lifts the box. */}
<a
  href={href}
  class={`group ${accent} flex h-full flex-col border border-rule bg-paper-2/25 transition-colors duration-500 hover:border-rule-2 hover:bg-paper-2/70`}
  data-reveal
  style={`--reveal-delay:${delay}ms`}>
  {/* The panel's colour, stated once at the top edge. Thin enough to read as a
      rule rather than a banner. */}
  <div class="h-[3px] w-full bg-accent/70" aria-hidden="true"></div>

  {
    diagram && (
      <div class="flex h-32 items-center overflow-hidden border-b border-rule bg-paper px-5 sm:h-36">
        <Diagram name={diagram} bare class="w-full" />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    {/* Org first, then dates. "Built at AWS" is the fact that sets the stakes. */}
    <div class="flex items-baseline justify-between gap-4">
      <span class="label !text-accent">{org}</span>
      <span class="shrink-0 text-[0.75rem] text-ink-3">{period}</span>
    </div>

    <h3 class="display mt-4 flex items-start justify-between gap-4 text-[1.5rem] text-ink">
      <span>{title}</span>
      <Icon
        name="arrow"
        class="mt-2.5 h-3.5 w-3.5 shrink-0 text-ink-3 transition-transform duration-500 ease-settle group-hover:translate-x-1.5"
      />
    </h3>

    <p class="mt-2.5 text-[0.875rem] text-accent">{tagline}</p>

    {
      shown.length > 0 && (
        <dl class="mt-6 grid grid-cols-2 gap-x-5 gap-y-4">
          {shown.map((m) => (
            <div>
              <dd class="num text-[1.25rem] leading-none text-ink">{m.value}</dd>
              <dt class="mt-1.5 text-xs leading-snug text-ink-3">{m.label}</dt>
            </div>
          ))}
        </dl>
      )
    }

    {/* mt-auto pins the chips to the bottom, so panels of unequal text length
        still line their chip rows up across the grid. */}
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-7">
      {chips.map((s) => <li class="chip">{s}</li>)}
      {extra > 0 && <li class="chip">+{extra}</li>}
    </ul>
  </div>
</a>
