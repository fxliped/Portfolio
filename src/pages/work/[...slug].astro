---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Diagram from "../../components/Diagram.astro";
import Figure from "../../components/Figure.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all[(idx + 1) % all.length];

// Same divider/indent rule as the hero stats — see StatTiles.astro.
function cellClass(i: number): string {
  if (i === 0) return "pl-0 sm:pl-0 border-l-0 sm:border-l-0";
  if (i % 2 === 0) return "pl-0 sm:pl-6 border-l-0 sm:border-l";
  return "pl-5 sm:pl-6 border-l";
}
---

<Base title={`${d.title} · ${d.tagline}`} description={d.summary}>
  <article class="mx-auto max-w-5xl px-6 pt-36 sm:px-10 sm:pt-44">
    <a
      href="/#work"
      class="group label inline-flex items-center gap-2 transition-colors duration-200 hover:!text-ink">
      <Icon
        name="arrow"
        class="h-3 w-3 rotate-180 transition-transform duration-300 ease-settle group-hover:-translate-x-1"
      />
      All work
    </a>

    <header class="mt-8 max-w-3xl">
      <h1 class="display text-[2.75rem] text-ink sm:text-[3.5rem]">{d.title}</h1>
      <p class="mt-5 text-[1.125rem] text-accent">{d.tagline}</p>
      <p class="mt-6 text-[1.0625rem] leading-relaxed text-ink-2">{d.summary}</p>
    </header>

    {
      d.metrics.length > 0 && (
        <dl class="mt-14 grid grid-cols-2 gap-y-8 border-t border-rule pt-10 sm:grid-cols-4 sm:gap-y-0">
          {d.metrics.map((m, i) => (
            <div
              class:list={["border-rule", cellClass(i)]}
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}>
              <dd class="num text-[2.25rem] leading-none text-ink">{m.value}</dd>
              <dt class="mt-3 text-xs leading-snug text-ink-3">{m.label}</dt>
            </div>
          ))}
        </dl>
      )
    }

    {
      d.figures.length > 0 && (
        <div class="mt-16 space-y-12">
          {d.figures.map((f, i) => (
            <Diagram name={f.diagram} caption={f.caption} fig={i + 1} />
          ))}
        </div>
      )
    }

    <div class="mt-20 grid gap-12 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-20">
      <!-- Sticky meta rail: pins on desktop, stacks above the prose on mobile. -->
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <dl class="space-y-7 border-t border-rule pt-7 lg:border-t-0 lg:pt-0">
          <div>
            <dt class="label">Role</dt>
            <dd class="mt-2 text-[0.9375rem] leading-snug text-ink">{d.role}</dd>
          </div>
          <div>
            <dt class="label">Period</dt>
            <dd class="mt-2 text-[0.9375rem] text-ink">{d.period}</dd>
          </div>
          <div>
            <dt class="label">Stack</dt>
            <dd class="mt-2.5 flex flex-wrap gap-1.5">
              {d.stack.map((s) => <span class="chip">{s}</span>)}
            </dd>
          </div>
          {
            d.links.length > 0 && (
              <div>
                <dt class="label">Links</dt>
                <dd class="mt-2.5 space-y-2">
                  {d.links.map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1.5 text-[0.9375rem] text-accent underline decoration-1 underline-offset-4">
                      {l.label}
                      <Icon name="external" class="h-3 w-3" />
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="max-w-[38rem]">
        <div class="prose">
          <Content />
        </div>

        {
          d.images.length > 0 && (
            <div class="mt-14 space-y-10">
              {/* Numbering continues from the diagrams above. */}
              {d.images.map((img, i) => (
                <Figure
                  src={img.src}
                  alt={img.alt}
                  width={img.width}
                  height={img.height}
                  caption={img.caption}
                  fig={d.figures.length + i + 1}
                />
              ))}
            </div>
          )
        }
      </div>
    </div>

    <nav class="mt-28 border-t border-rule pt-9">
      <a href={`/work/${next.id}`} class="group block">
        <p class="label">Next project</p>
        <p class="display mt-3 flex items-center gap-4 text-[1.75rem] text-ink sm:text-[2rem]">
          {next.data.title}
          <Icon
            name="arrow"
            class="h-5 w-5 shrink-0 text-ink-3 transition-transform duration-500 ease-settle group-hover:translate-x-2"
          />
        </p>
      </a>
    </nav>
  </article>
</Base>
