---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Not found">
  <section class="mx-auto grid min-h-[70dvh] max-w-5xl place-items-center px-6 sm:px-10">
    <div>
      <p class="label">404</p>
      <h1 class="display mt-4 text-[2.75rem] text-ink sm:text-[3.5rem]">Nothing here</h1>
      <p class="mt-5 text-[1.0625rem] text-ink-2">That page doesn't exist — or it moved.</p>
      <a
        href="/"
        class="group mt-8 inline-flex items-center gap-2 text-ink underline decoration-rule-2 decoration-1 underline-offset-[5px] transition-colors duration-200 hover:decoration-accent">
        Back home
        <Icon
          name="arrow"
          class="h-3.5 w-3.5 text-ink-3 transition-transform duration-300 ease-settle group-hover:translate-x-1"
        />
      </a>
    </div>
  </section>
</Base>
